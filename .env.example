# Commercial web runtime
COMMERCIAL_ENV=development
COMMERCIAL_DB_PATH=
COMMERCIAL_PAYMENT_WEBHOOK_SECRET=commercial-webhook-secret
COMMERCIAL_MANUAL_TRANSFER_ACCOUNT_NAME=AI Novel Generator 商业版
COMMERCIAL_MANUAL_TRANSFER_ACCOUNT_NO=6222-0000-0000-0000
COMMERCIAL_MANUAL_TRANSFER_BANK_NAME=示例银行上海分行

# Backend bind and public URL
COMMERCIAL_BACKEND_BIND_HOST=127.0.0.1
COMMERCIAL_BACKEND_HOST=127.0.0.1
COMMERCIAL_BACKEND_PORT=8000
COMMERCIAL_BACKEND_URL=http://127.0.0.1:8000

# Frontend bind and discovery
COMMERCIAL_FRONTEND_BIND_HOST=127.0.0.1
COMMERCIAL_FRONTEND_HOST=127.0.0.1
COMMERCIAL_FRONTEND_PORT=4173
COMMERCIAL_FRONTEND_PORT_CANDIDATES=4173,4174,4175,4176,4177,4178,4179,4180,4181,4182,4183,4184,4185,4186,4187,4188,4189,4190,5173,5174,5175,5176,5177,5178,5179,5180,5181,5182,5183,5184,5185

# Backend CORS whitelist
COMMERCIAL_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:3000,http://localhost:3000

# Admin audit log list default size
COMMERCIAL_AUDIT_LOG_LIMIT=100
